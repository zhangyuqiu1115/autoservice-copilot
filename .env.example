APP_NAME=AutoService Copilot API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1
# 本地审核密钥；留空会禁用审批、关闭、重新送审及审核历史接口。
REVIEW_API_KEY=
DATABASE_URL=sqlite:///./autoservice.db
UPLOAD_DIRECTORY=data/uploads
MAX_UPLOAD_SIZE_MB=10

DOCUMENT_CHUNK_SIZE_CHARS=1000
DOCUMENT_CHUNK_OVERLAP_CHARS=200

QDRANT_PATH=data/qdrant
QDRANT_COLLECTION_NAME=document_chunks
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIRECTORY=data/models
RETRIEVAL_TOP_K=5

RAG_PROVIDER=extractive
RAG_MIN_SCORE=0.35
RAG_MAX_CONTEXT_CHARS=6000

# RAG_PROVIDER=openai_compatible 时填写：
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=your-model-name
# LLM_TIMEOUT_SECONDS=30
